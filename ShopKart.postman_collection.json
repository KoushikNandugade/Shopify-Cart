{
  "info": {
    "name": "ShopKart Lab 01",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order with cookies enabled. Registration expects a new email; change it if already used."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "productId",
      "value": "530000000000000000000001"
    },
    {
      "key": "shopKartOrderId",
      "value": ""
    },
    {
      "key": "razorpayOrderId",
      "value": ""
    },
    {
      "key": "razorpayPaymentId",
      "value": ""
    },
    {
      "key": "razorpaySignature",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/customers/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@gmail.com\",\n  \"password\": \"john123\",\n  \"phone\": \"9876543210\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/customers/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"john@gmail.com\",\n  \"password\": \"john123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "My profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/customers/me",
        "header": []
      }
    },
    {
      "name": "Change password (bonus)",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/customers/change-password",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"oldPassword\": \"john123\",\n  \"newPassword\": \"newpass123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Login with new password",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/customers/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"john@gmail.com\",\n  \"password\": \"newpass123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/customers/logout",
        "header": []
      }
    },
    {
      "name": "Profile after logout (expect 401)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/customers/me",
        "header": []
      }
    },
    {
      "name": "Lab 03 - Products",
      "item": [
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"description\": \"RGB mechanical keyboard with blue switches.\",\n  \"price\": 2999,\n  \"category\": \"Electronics\",\n  \"image\": \"/product-images/keyboard.svg\",\n  \"stock\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created product\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"productId\", pm.response.json().product._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "All products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products",
            "header": []
          }
        },
        {
          "name": "Search products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?search=keyboard",
            "header": []
          }
        },
        {
          "name": "Filter products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?category=Electronics",
            "header": []
          }
        },
        {
          "name": "Combined search and category",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?search=keyboard&category=Electronics",
            "header": []
          }
        },
        {
          "name": "Sort price ascending",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?sort=price_asc",
            "header": []
          }
        },
        {
          "name": "Sort price descending",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?sort=price_desc",
            "header": []
          }
        },
        {
          "name": "Single product",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}",
            "header": []
          }
        },
        {
          "name": "Invalid product ID (400)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/invalid",
            "header": []
          }
        },
        {
          "name": "Missing product (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/000000000000000000000000",
            "header": []
          }
        }
      ]
    },
    {
      "name": "Lab 04 - Wishlist (login first; run in order)",
