        },
        {
          "name": "Remove product",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/wishlist/{{productId}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove again (404)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/wishlist/{{productId}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Lab 05 - Cart (login first; fresh cart; stock at least 3)",
      "item": [
        {
          "name": "Add product (quantity 1)",
          "request": {
